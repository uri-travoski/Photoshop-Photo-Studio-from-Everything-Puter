{
  "name": "puter-photo-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Professional Photo & Image Editor",
  "author": "Puter Team <support@puter.com>",
  "homepage": "https://puter.com",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && npm run build:worker && vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "dist": "npm run build && electron-builder --linux deb rpm AppImage flatpak",
    "dist:all": "npm run build && electron-builder --linux deb rpm AppImage flatpak",
    "dist:deb": "npm run build && electron-builder --linux deb",
    "dist:rpm": "npm run build && electron-builder --linux rpm",
    "dist:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:flatpak": "npm run build && electron-builder --linux flatpak",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "wasm:build": "cargo build --manifest-path wasm/Cargo.toml --target wasm32-unknown-unknown --release && cp wasm/target/wasm32-unknown-unknown/release/photo_engine.wasm public/photo-engine.wasm",
    "test:browser": "playwright test",
    "psd:audit": "node scripts/audit-psd.mjs",
    "perf:bundle": "node scripts/perf-bundle.mjs",
    "perf:startup": "node scripts/perf-startup.mjs",
    "test:rust": "cargo test --manifest-path wasm/Cargo.toml"
  },
  "dependencies": {
    "ag-psd": "31.0.2",
    "lucide": "^0.468.0",
    "pako": "2.1.0",
    "pathkit-wasm": "1.0.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "24.19.1",
    "@types/pako": "2.0.4",
    "@webgpu/types": "^0.1.60",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
